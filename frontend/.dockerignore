# ==========================================
# Frontend .dockerignore
# ==========================================

# Dependency directories
node_modules/
**/node_modules/

# Next.js build artifacts and cache
.next/
**/.next/
out/
**/out/
.turbo/
**/.turbo/
dist/
build/
*.tsbuildinfo

# Environment and sensitive credential files
.env
.env.*
*.env
!.env.example

# Version control
.git/
.gitignore

# Debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Documentation and Docker files
*.md
!README.md
Dockerfile
.dockerignore
